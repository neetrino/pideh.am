# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / auth
AUTH_SECRET=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cache / rate limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
# Inlined for client brand rasters (same value as R2_PUBLIC_BASE_URL via next.config)

# Email (Resend adapter)
EMAIL_FROM=
RESEND_API_KEY=

# Google Maps (Geocoding + Routes + Maps JavaScript for address picker)
# Enable: Geocoding API, Routes API, Places API (New), Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# Tidio live chat (public key from the widget script URL; widget hidden when empty)
TIDIO_PUBLIC_KEY=

# Web Push for admin new-order notifications (disabled when empty)
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required when NEXT_PUBLIC_APP_URL is not https (e.g. local): mailto:you@example.com
VAPID_SUBJECT=

# Dev/test seed only (never commit real passwords)
